{
  "name": "backend",
  "version": "1.0.0",
  "description": "Astrovia astronomy social network API",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node --check server.js && node --check src/app.js",
    "admin:grant": "node scripts/set-admin.mjs",
    "admin:revoke": "node scripts/set-admin.mjs --revoke"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "astronomy",
    "firebase",
    "express",
    "social-network"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
