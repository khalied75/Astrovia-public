NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_DATABASE_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_JSON=base64-encoded-service-account-json
CLOUDFLARE_R2_ACCOUNT_ID=your-r2-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=your-r2-bucket
CLOUDFLARE_R2_PUBLIC_URL=https://your-public-r2-domain.example
